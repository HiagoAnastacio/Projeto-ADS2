# --- CONFIGURAÇÕES DE EXEMPLO (.env) ---
# Copie este arquivo para ".env" e preencha com seus dados reais.

# Senha ROOT do MySQL (Defina uma senha forte)
MYSQL_ROOT_PASSWORD=senha_root_secreta

# Usuário e Senha da Aplicação (Banco de Dados)
MYSQL_USER=meta_user
MYSQL_PASSWORD=meta_password

# Nome do Banco de Dados
MYSQL_DATABASE=overwatch_meta_analyzer

# Nome do Domínio (Ex: meudominio.com)
DOMAIN_NAME=localhost

# Email para o Let's Encrypt (Necessário para HTTPS em produção)
ACME_EMAIL=seu_email@exemplo.com
